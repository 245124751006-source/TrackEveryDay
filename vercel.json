{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,index.html,counter-demo.html,css/**,js/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
